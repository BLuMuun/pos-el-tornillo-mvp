        <mxCell id="Titulo" value="Flujo de registro de venta y control de stock" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=34;fontStyle=1;fontColor=#203B64;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="50" y="24" width="1500" height="58" as="geometry"/></mxCell>
        <mxCell id="Subtitulo" value="Flujo normal, falta de stock, error de guardado y alerta bajo 10" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontColor=#596A7D;fontFamily=Arial;" vertex="1" parent="1"><mxGeometry x="52" y="82" width="1500" height="42" as="geometry"/></mxCell>
        <mxCell id="Inicio" value="&lt;div style='font-family:Arial;font-size:22px;font-weight:bold;color:#203B64;'&gt;Inicio: seleccionar productos y cantidades&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#008B99;strokeWidth=2;fillColor=#EAF2F8;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="430" y="160" width="740" height="82" as="geometry"/></mxCell>
        <mxCell id="Revision" value="&lt;div style='font-family:Arial;font-size:20px;font-weight:bold;color:#ffffff;background-color:#203B64;padding:10px;'&gt;Revisar productos y stock disponible&lt;/div&gt;&lt;div style='font-family:Arial;font-size:17px;color:#252525;padding:14px;'&gt;Al confirmar, el sistema vuelve a comprobar las existencias.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#008B99;strokeWidth=2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="390" y="320" width="820" height="130" as="geometry"/></mxCell>
        <mxCell id="DecisionStock" value="&lt;div style='font-family:Arial;font-size:21px;font-weight:bold;color:#252525;'&gt;¿Hay stock suficiente para todos los productos?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#203B64;strokeWidth=2;fillColor=#EAF2F8;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="540" width="460" height="160" as="geometry"/></mxCell>
        <mxCell id="Rechazar" value="&lt;div style='font-family:Arial;font-size:19px;font-weight:bold;color:#ffffff;background-color:#A52D2D;padding:10px;'&gt;Rechazar venta&lt;/div&gt;&lt;div style='font-family:Arial;font-size:16px;color:#252525;padding:12px;'&gt;Informar el producto sin stock. No modificar el inventario.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#A52D2D;strokeWidth=2;fillColor=#FFF3F3;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="45" y="570" width="350" height="155" as="geometry"/></mxCell>
        <mxCell id="FinSinCambios" value="&lt;div style='font-family:Arial;font-size:18px;font-weight:bold;color:#A52D2D;'&gt;Fin sin cambios&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#A52D2D;strokeWidth=2;fillColor=#FFF3F3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="100" y="790" width="240" height="75" as="geometry"/></mxCell>
        <mxCell id="Transaccion" value="&lt;div style='font-family:Arial;font-size:20px;font-weight:bold;color:#ffffff;background-color:#203B64;padding:10px;'&gt;Guardar dentro de una transacción&lt;/div&gt;&lt;div style='font-family:Arial;font-size:17px;color:#252525;padding:14px;'&gt;Registrar venta y detalles, y descontar el stock como una sola operación.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#008B99;strokeWidth=2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="430" y="790" width="740" height="135" as="geometry"/></mxCell>
        <mxCell id="DecisionConfirmada" value="&lt;div style='font-family:Arial;font-size:21px;font-weight:bold;color:#252525;'&gt;¿Se confirmó la transacción sin error?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#203B64;strokeWidth=2;fillColor=#EAF2F8;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="1010" width="460" height="160" as="geometry"/></mxCell>
        <mxCell id="Revertir" value="&lt;div style='font-family:Arial;font-size:19px;font-weight:bold;color:#ffffff;background-color:#A52D2D;padding:10px;'&gt;Revertir cambios&lt;/div&gt;&lt;div style='font-family:Arial;font-size:16px;color:#252525;padding:12px;'&gt;No dejar una venta parcial ni un descuento incompleto. Mostrar el error.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#A52D2D;strokeWidth=2;fillColor=#FFF3F3;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1210" y="1010" width="330" height="155" as="geometry"/></mxCell>
        <mxCell id="FinError" value="&lt;div style='font-family:Arial;font-size:18px;font-weight:bold;color:#A52D2D;'&gt;Fin con error informado&lt;/div&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;strokeColor=#A52D2D;strokeWidth=2;fillColor=#FFF3F3;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1245" y="1210" width="260" height="70" as="geometry"/></mxCell>
        <mxCell id="Confirmada" value="&lt;div style='font-family:Arial;font-size:21px;font-weight:bold;color:#203B64;'&gt;Venta confirmada y stock actualizado&lt;/div&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;strokeColor=#008B99;strokeWidth=2;fillColor=#EAF2F8;align=center;verticalAlign=middle;spacing=10;" vertex="1" parent="1"><mxGeometry x="430" y="1260" width="740" height="100" as="geometry"/></mxCell>
        <mxCell id="DecisionUmbral" value="&lt;div style='font-family:Arial;font-size:21px;font-weight:bold;color:#252525;'&gt;¿Algún producto quedó con stock menor que 10?&lt;/div&gt;" style="rhombus;whiteSpace=wrap;html=1;strokeColor=#203B64;strokeWidth=2;fillColor=#EAF2F8;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="570" y="1440" width="460" height="160" as="geometry"/></mxCell>
        <mxCell id="GenerarAlerta" value="&lt;div style='font-family:Arial;font-size:19px;font-weight:bold;color:#ffffff;background-color:#A76500;padding:10px;'&gt;Generar alerta al dueño&lt;/div&gt;&lt;div style='font-family:Arial;font-size:16px;color:#252525;padding:12px;'&gt;Guardar producto y stock observado. Canal por confirmar.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#A76500;strokeWidth=2;fillColor=#FFF8E7;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="45" y="1650" width="350" height="150" as="geometry"/></mxCell>
        <mxCell id="SinAlerta" value="&lt;div style='font-family:Arial;font-size:19px;font-weight:bold;color:#ffffff;background-color:#203B64;padding:10px;'&gt;Continuar sin alerta&lt;/div&gt;&lt;div style='font-family:Arial;font-size:16px;color:#252525;padding:12px;'&gt;Con 10 unidades exactas no se activa el aviso.&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;strokeColor=#008B99;strokeWidth=2;fillColor=#FFFFFF;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="1205" y="1650" width="350" height="150" as="geometry"/></mxCell>
